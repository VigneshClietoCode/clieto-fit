{
  "name": "clieto-fit",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"npm run web:dev\" \"npm run api:dev\"",
    "web:dev": "next dev",
    "dev:mobile": "npm --prefix apps/mobile run start -- --lan",
    "build": "prisma generate && next build",
    "start": "next start",
    "api:dev": "npm run dev --workspace @clieto-fit/api",
    "api:build": "prisma generate && npm run build --workspace @clieto-fit/api",
    "api:start": "npm run start --workspace @clieto-fit/api",
    "api:typecheck": "npm run typecheck --workspace @clieto-fit/api",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test --workspace @clieto-fit/api",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^10.0.7",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "minimatch": "^11.0.8"
  }
}
