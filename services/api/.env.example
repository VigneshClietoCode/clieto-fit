# PostgreSQL connection string (Supabase or any Postgres provider)
SUPABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Session signing secret — must be at least 32 random characters
SESSION_SECRET="generate-with: openssl rand -hex 32"

# Optional: scope the session cookie to a specific domain (e.g. .clietocode.com)
# SESSION_COOKIE_DOMAIN=".clietocode.com"

# Google OAuth client ID — required for Google SSO.
# Must match the value set in the web app's environment.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
