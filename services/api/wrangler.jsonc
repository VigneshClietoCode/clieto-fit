{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clietofit-api",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "e581027e05f84aa8ab2932a7659f6000"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "clietofit-api"
    }
  ],
  "observability": {
    "enabled": true
  }
}
