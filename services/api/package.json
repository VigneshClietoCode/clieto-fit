{
  "name": "@clieto-fit/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "build:cloudflare": "prisma generate && opennextjs-cloudflare build",
    "deploy:cloudflare": "wrangler deploy",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/policies.test.ts src/proxy.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@clieto-fit/shared": "1.0.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swagger-ui-react": "^5.35.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/swagger-ui-react": "^5.18.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.163.0"
  }
}
