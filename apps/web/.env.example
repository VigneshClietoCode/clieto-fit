# URL of the API service (used server-side by the Next.js proxy route)
API_INTERNAL_URL="http://localhost:3001"

# Google OAuth client ID — required for the "Sign in with Google" button.
# Get this from https://console.cloud.google.com → APIs & Services → Credentials.
# Both variables must be set to the same value: GOOGLE_CLIENT_ID is read by the
# API service (server-side token verification), NEXT_PUBLIC_GOOGLE_CLIENT_ID is
# exposed to the browser to initialise the Google GSI script.
GOOGLE_CLIENT_ID="279662052023-57qrf1fsi0i8nu3q89lt20hpvqoet9hc.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="279662052023-57qrf1fsi0i8nu3q89lt20hpvqoet9hc.apps.googleusercontent.com"
